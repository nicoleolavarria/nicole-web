# Variables de entorno de nicole-web. Este archivo NO tiene valores: copia a .env (local, no se sube a git)
# y deja en blanco lo que no uses. Los secretos de producción NO van en .env: se cargan en Cloudflare.

# ---- Cloudflare Worker (panel, API, cron). Cargar con: npx wrangler secret put NOMBRE ----
# ADMIN_TOKEN=          # OBLIGATORIA. Clave de entrada al panel de admin (/api/admin/login). Sin ella nadie entra.
# AVISOS_TOKEN=         # Token para /api/admin/avisos-wa y /api/agenda/ical (enlaces privados de avisos).
# MP_ACCESS_TOKEN=      # Access token de Mercado Pago (pagos con tarjeta). Solo el de PRODUCCIÓN, nunca en git.
# RESEND_API_KEY=       # Resend, para correos a alumnos. Sin ella la reserva funciona pero no sale el correo.
# VAPID_PRIVATE_KEY=    # Clave privada para notificaciones push (la pública va en wrangler.toml [vars]).
# ANTHROPIC_API_KEY=    # Chatbot/asistente con IA del panel (opcional).

# ---- Cloudflare Worker: variables públicas (ya están en wrangler.toml, no hace falta ponerlas aquí) ----
# VAPID_PUBLIC_KEY=

# ---- Bindings de wrangler (NO son variables: se configuran en wrangler.toml o en el dashboard) ----
# DB (D1 nicole-crm), RECURSOS_R2 (R2 nicole-recursos), ASSETS, AI, AVISOS (Email Routing / envío de correo).

# ---- Despliegue desde la terminal (scripts de bin/) ----
# CLOUDFLARE_API_TOKEN=  # Token de la cuenta de Nicole. Los scripts lo leen de .cf-api-token.local (no lo copies aquí).
# CLOUDFLARE_ACCOUNT_ID= # 75cb4a4b... (ID de la cuenta de Nicole, público; ver wrangler.toml).

# ---- Web pública (Vercel / build de Astro) ----
# NICOLE_LOCAL_ORIGIN=  # Solo desarrollo local: http://127.0.0.1:PUERTO apuntando a un worker local. En Vercel déjalo vacío.

# ---- Herramientas locales y pruebas (no van a producción) ----
# WORKER=               # URL del worker para bin/avisos-wa.mjs (por defecto el *.workers.dev de Nicole).
# PUERTO_BOT=           # Puerto del bot de WhatsApp local (por defecto 3402).
# SECO=                 # 1 = modo seco en bin/avisos-wa.mjs (no envía nada).
# BASE=                 # URL base para tests/e2e (ej. http://127.0.0.1:4321).
# E2E_TOKEN=            # Token de sesión de prueba para tests/e2e. Usa una cuenta de prueba, nunca la real.
# SHOTS=                # Carpeta de capturas para tests/e2e/header-espaciado.e2e.mjs.
# TINTA= LETRA= FORMA= FONDO=  # Opcionales para scripts/build-favicon.mjs (colores, letra y forma del favicon).
