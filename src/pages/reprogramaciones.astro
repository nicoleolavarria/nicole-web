---
/* REPROGRAMACIONES (privado, flujo 2 · 26-sep-2026): el alumno ubica su clase con su correo,
   elige nueva hora libre; queda una solicitud pendiente que Nicole acepta en Mi agenda. */
import { obtenerWeb, ORIGEN } from '../lib/web-data.mjs';
import { headerHtml, pieHtml, estiloCss, fuentesHref, mezclar } from '../lib/web-render.mjs';

const { web } = await obtenerWeb();
const data = mezclar(web);
const cssExtra = estiloCss(data);
const hrefFuentes = fuentesHref(data);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reprogramaciones — Nicole Olavarría</title>
  <meta name="description" content="Enlace privado con las horas libres de Nicole para reprogramar una clase." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet" />
  {hrefFuentes && <link href={hrefFuentes} rel="stylesheet" id="fuentesNicole" />}
  <link rel="stylesheet" href="/styles/global.css" />
  {cssExtra && <style id="estiloNicole" set:html={cssExtra} />}
  <style is:global>
    /* El rosa lo eligió Nicole. Aquí es el color de lo elegido, no del fondo:
       marca la fecha y la hora que la persona acaba de tocar. */
    :root { --rosa: #fee1f2; }

    .hor-wrap { max-width: min(680px, var(--ancho)); margin: 0 auto; padding: 44px 20px 72px; }
    @media (min-width: 700px) { .hor-wrap { padding: 72px 40px 96px; } }

    .hor-wrap h1 { margin-bottom: 10px; }
    .hor-intro { font-size: calc(14px * var(--esc)); line-height: 1.65; color: var(--muted); margin-bottom: 6px; }
    .hor-tz { font-size: calc(12.5px * var(--esc)); color: var(--muted); margin: 10px 0 0; }

    .hor-paso { margin-top: 34px; }
    .hor-paso > h2 {
      font-family: var(--font-titulo); font-size: calc(11px * var(--esc));
      letter-spacing: .12em; text-transform: uppercase; color: var(--muted);
      border-bottom: 1px solid var(--line); padding-bottom: 8px; margin-bottom: 16px;
    }

    /* --- tira de días --- */
    .hor-dias { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 10px; -webkit-overflow-scrolling: touch; }
    .hor-dias::-webkit-scrollbar { height: 3px; }
    .hor-dias::-webkit-scrollbar-thumb { background: var(--line); }
    .hor-dia {
      flex: 0 0 auto; min-width: 74px; min-height: 78px;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
      border: 1px solid var(--line); background: var(--bg); color: var(--fg);
      font-family: var(--font-cuerpo); cursor: pointer; padding: 10px 8px;
      transition: border-color .12s, background .12s;
    }
    .hor-dia .d-sem { font-size: calc(11px * var(--esc)); letter-spacing: .08em; text-transform: lowercase; color: var(--muted); }
    .hor-dia .d-num { font-size: calc(21px * var(--esc)); line-height: 1.1; }
    .hor-dia .d-est { font-size: calc(10px * var(--esc)); letter-spacing: .06em; color: var(--muted); }
    .hor-dia[aria-pressed="true"] { background: var(--rosa); border-color: var(--fg); }
    .hor-dia[aria-pressed="true"] .d-sem, .hor-dia[aria-pressed="true"] .d-est { color: var(--fg); }
    .hor-dia:disabled { cursor: default; opacity: .45; }

    /* --- horas --- */
    .hor-horas { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 10px; }
    .hor-hora {
      min-height: 52px; border: 1px solid var(--line); background: var(--bg); color: var(--fg);
      font-family: var(--font-cuerpo); font-size: calc(15px * var(--esc)); cursor: pointer;
      transition: border-color .12s, background .12s;
    }
    .hor-hora:hover { border-color: var(--fg); }
    .hor-hora[aria-pressed="true"] { background: var(--rosa); border-color: var(--fg); }

    /* --- tarjeta de reserva --- */
    .hor-card { border: 1px solid var(--fg); padding: 22px 20px; margin-top: 26px; background: var(--bg); }
    .hor-card .elegido { font-size: calc(17px * var(--esc)); line-height: 1.45; margin-bottom: 4px; }
    .hor-card .elegido-sub { font-size: calc(12.5px * var(--esc)); color: var(--muted); margin-bottom: 18px; }
    .hor-campo { margin-bottom: 14px; }
    .hor-campo label { display: block; font-size: calc(12px * var(--esc)); letter-spacing: .06em; color: var(--muted); margin-bottom: 6px; }
    .hor-campo input {
      width: 100%; min-height: 50px; padding: 0 12px; box-sizing: border-box;
      border: 1px solid var(--line); background: var(--bg); color: var(--fg);
      font-family: var(--font-cuerpo); font-size: calc(15px * var(--esc));
    }
    .hor-campo input:focus { outline: none; border-color: var(--fg); }
    .hor-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

    .hor-btn {
      width: 100%; min-height: 54px; border: 1px solid var(--fg); background: var(--fg); color: var(--bg);
      font-family: var(--font-cuerpo); font-size: calc(15px * var(--esc)); letter-spacing: .04em; cursor: pointer;
    }
    .hor-btn:disabled { opacity: .5; cursor: default; }
    .hor-error {
      margin-top: 14px; padding: 12px 14px; border: 1px solid var(--fg);
      font-size: calc(13.5px * var(--esc)); line-height: 1.5;
    }
    .hor-portal { margin-top: 18px; font-size: calc(13px * var(--esc)); color: var(--muted); }

    /* --- confirmación --- */
    .hor-listo { border: 1px solid var(--fg); background: var(--rosa); padding: 34px 24px; text-align: center; margin-top: 26px; }
    .hor-listo .tick { display: block; margin: 0 auto 16px; }
    .hor-listo h2 { font-family: var(--font-titulo); font-size: calc(24px * var(--esc) * var(--esc-tit)); margin-bottom: 12px; border: 0; padding: 0; letter-spacing: 0; text-transform: none; color: var(--fg); }
    .hor-listo p { font-size: calc(15px * var(--esc)); line-height: 1.6; margin-bottom: 8px; }
    .hor-listo .cuando { font-size: calc(17px * var(--esc)); }

    .hor-vacio { font-size: calc(13.5px * var(--esc)); color: var(--muted); line-height: 1.6; }
  </style>
  <style is:global>
    .hor-serie { list-style: none; padding: 0; margin: 0 0 18px; display: grid; gap: 6px; }
    .hor-serie li { font-size: calc(14px * var(--esc)); line-height: 1.5; padding: 8px 12px; border: 1px solid var(--line); }
    .hor-opcional { color: var(--muted); font-weight: normal; }
    .hor-wa { display: flex; align-items: center; justify-content: center; text-decoration: none; margin-top: 12px; }
  </style>
</head>
<body data-pagina="horarios">
  <Fragment set:html={headerHtml(data)} />
  <main>
    <div class="hor-wrap">
      <h1>Reprogramar una clase</h1>
      <p class="hor-intro">Escribe el correo con el que separaste tus clases, elige la que quieres mover y el nuevo horario. Nicole te confirma el cambio.</p>
      <p class="hor-tz" id="tzNota" hidden></p>

      <section class="hor-paso" id="paso1">
        <h2>1 · Tu correo</h2>
        <form class="hor-card" id="formEmail" novalidate style="margin-top:0">
          <div class="hor-campo"><label for="r_email">Correo con el que separaste tus clases</label><input id="r_email" type="email" autocomplete="email" maxlength="120" /></div>
          <button class="hor-btn" type="submit" id="btnBuscar">Ver mis clases</button>
          <div class="hor-error" id="err1" hidden></div>
        </form>
      </section>

      <section class="hor-paso" id="paso2" hidden>
        <h2>2 · La clase que quieres cambiar</h2>
        <div class="hor-horas" id="misClases" style="grid-template-columns:1fr"></div>
      </section>

      <section class="hor-paso" id="paso3" hidden>
        <h2>3 · El nuevo día</h2>
        <div class="hor-dias" id="dias" aria-live="polite"></div>
      </section>

      <section class="hor-paso" id="pasoHoras" hidden>
        <h2>4 · La nueva hora</h2>
        <div class="hor-horas" id="horas"></div>
      </section>

      <section id="pasoPedir" hidden>
        <div class="hor-card">
          <p class="elegido-sub">Tu cambio:</p>
          <ol class="hor-serie" id="resumen"></ol>
          <button class="hor-btn" type="button" id="btnPedir">Pedir el cambio</button>
          <div class="hor-error" id="err2" hidden></div>
        </div>
      </section>

      <section id="pasoListo" hidden>
        <div class="hor-listo">
          <h2>Listo, cambio pedido</h2>
          <ol class="hor-serie" id="listoResumen"></ol>
          <p id="listoCorreo"></p>
          <p>Último paso: envíale el cambio a Nicole por WhatsApp para que te lo confirme. Mientras tanto, tu clase original sigue en pie.</p>
          <a class="hor-btn hor-wa" id="btnWaListo" href="#" target="_blank" rel="noopener">Enviar a Nicole por WhatsApp</a>
        </div>
      </section>
    </div>
  </main>
  <Fragment set:html={pieHtml(data)} />

  <script is:inline define:vars={{ ORIGEN }}>
    (function () {
      var API = ORIGEN + '/api/agenda/privado';
      var LIMA = 'America/Lima';
      var tz = LIMA;
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || LIMA; } catch (e) {}
      var K = new URLSearchParams(location.search).get('k') || '';
      function fmt(iso, opts) { return new Intl.DateTimeFormat('es-PE', Object.assign({ timeZone: tz }, opts)).format(new Date(iso)); }
      function claveLocal(d) { return new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d); }
      function largo(iso) { return fmt(iso, { weekday: 'long', day: 'numeric', month: 'long' }) + ' · ' + fmt(iso, { hour: 'numeric', minute: '2-digit' }); }
      function notaTz() {
        if (tz === LIMA) return;
        var n = document.getElementById('tzNota');
        n.textContent = 'Las horas se muestran en tu hora local (' + tz.replace(/_/g, ' ') + '). Nicole está en Lima.';
        n.hidden = false;
      }
      function pintarDias(elDias, porDia, alElegir) {
        var claves = Object.keys(porDia).sort();
        elDias.innerHTML = claves.map(function (c) {
          var iso = porDia[c][0];
          return '<button type="button" class="hor-dia" data-dia="' + c + '" aria-pressed="false">' +
            '<span class="d-sem">' + fmt(iso, { weekday: 'short' }).replace('.', '') + '</span>' +
            '<span class="d-num">' + fmt(iso, { day: 'numeric' }) + '</span>' +
            '<span class="d-est">' + fmt(iso, { month: 'short' }).replace('.', '') + '</span></button>';
        }).join('');
        elDias.onclick = function (e) {
          var b = e.target.closest('.hor-dia');
          if (!b) return;
          elDias.querySelectorAll('.hor-dia').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
          alElegir(b.dataset.dia);
        };
        if (claves.length) elDias.querySelector('.hor-dia').click();
      }
      function pintarHoras(elHoras, isos, alElegir) {
        elHoras.innerHTML = isos.map(function (iso) {
          return '<button type="button" class="hor-hora" data-iso="' + iso + '" aria-pressed="false">' + fmt(iso, { hour: 'numeric', minute: '2-digit' }) + '</button>';
        }).join('');
        elHoras.onclick = function (e) {
          var b = e.target.closest('.hor-hora');
          if (!b) return;
          elHoras.querySelectorAll('.hor-hora').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
          alElegir(b.dataset.iso);
        };
      }
      var qk = K ? '&k=' + encodeURIComponent(K) : '';
      var email = '', original = null, nuevo = null, porDia = {};
      function $(id) { return document.getElementById(id); }
      function err(id, m) { $(id).textContent = m; $(id).hidden = !m; }

      $('formEmail').addEventListener('submit', function (e) {
        e.preventDefault();
        email = $('r_email').value.trim().toLowerCase();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { err('err1', 'Escribe un correo válido.'); return; }
        err('err1', '');
        fetch(API + '/mis-clases?email=' + encodeURIComponent(email) + qk).then(function (r) { return r.json(); }).then(function (d) {
          if (d.error) { err('err1', d.error); return; }
          if (!d.clases || !d.clases.length) { err('err1', 'No encontramos clases próximas con ese correo. Revisa que sea el mismo con el que separaste, o escríbele a Nicole.'); return; }
          $('misClases').innerHTML = d.clases.map(function (c) {
            return '<button type="button" class="hor-hora" data-id="' + c.id + '" data-iso="' + c.inicio + '" aria-pressed="false">' + largo(c.inicio) + '</button>';
          }).join('');
          $('paso2').hidden = false;
          $('paso2').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }).catch(function () { err('err1', 'No hay conexión. Intenta de nuevo.'); });
      });

      $('misClases').addEventListener('click', function (e) {
        var b = e.target.closest('.hor-hora'); if (!b) return;
        $('misClases').querySelectorAll('.hor-hora').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
        original = { id: b.dataset.id, iso: b.dataset.iso };
        fetch(API + '/libres' + (K ? '?k=' + encodeURIComponent(K) : '')).then(function (r) { return r.json(); }).then(function (d) {
          porDia = {};
          (d.slots || []).forEach(function (iso) { var c = claveLocal(new Date(iso)); (porDia[c] = porDia[c] || []).push(iso); });
          if (!Object.keys(porDia).length) { $('dias').innerHTML = '<p class="hor-vacio">No hay horas libres en las próximas semanas. Escríbele a Nicole.</p>'; }
          else { notaTz(); pintarDias($('dias'), porDia, alDia); }
          $('paso3').hidden = false;
        });
      });
      function alDia(clave) { $('pasoPedir').hidden = true; pintarHoras($('horas'), porDia[clave] || [], alHora); $('pasoHoras').hidden = false; }
      function alHora(iso) {
        nuevo = iso;
        $('resumen').innerHTML = '<li>Cambiar: ' + largo(original.iso) + '</li><li>Por: ' + largo(iso) + '</li>';
        $('pasoPedir').hidden = false;
        $('pasoPedir').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      $('btnPedir').addEventListener('click', function () {
        var btn = $('btnPedir'); btn.disabled = true; btn.textContent = 'Enviando…'; err('err2', '');
        fetch(API + '/reprogramar', { method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ k: K, email: email, reserva_id: original.id, nuevo_inicio: nuevo }) })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            btn.disabled = false; btn.textContent = 'Pedir el cambio';
            if (!d.ok) { err('err2', d.error || 'No se pudo. Intenta de nuevo.'); return; }
            $('listoResumen').innerHTML = $('resumen').innerHTML;
            $('listoCorreo').textContent = d.correo ? 'Te enviamos el detalle a ' + email + '.' : '';
            var waUrl = 'https://wa.me/' + (d.whatsapp || '51955127656') + '?text=' + encodeURIComponent(d.wa_texto || '');
            $('btnWaListo').href = waUrl;
            ['paso1', 'paso2', 'paso3', 'pasoHoras', 'pasoPedir'].forEach(function (x) { $(x).hidden = true; });
            $('pasoListo').hidden = false;
            setTimeout(function () { location.href = waUrl; }, 1800);
          })
          .catch(function () { btn.disabled = false; btn.textContent = 'Pedir el cambio'; err('err2', 'No hay conexión. Intenta de nuevo.'); });
      });
    })();
  </script>
</body>
</html>
